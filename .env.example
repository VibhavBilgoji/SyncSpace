# Server
PORT=8080
# MongoDB 8.0, the version Atlas free clusters run (docs/DEPLOYMENT.md section 3)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=syncspace
# Required. Base64, at least 32 bytes decoded, and different from each other. Generate each with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
TICKET_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SNAPSHOT_INTERVAL_SECS=5
METRICS_TOKEN=
# Optional: sign in with GitHub (docs/DEPLOYMENT.md section 5). Set all three or none.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_WEB_URL=
VERSION_INTERVAL_SECS=600
AUTO_VERSION_RETENTION=50
RUST_LOG=info,server=debug

# Web (apps/web/.env.local)
API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
